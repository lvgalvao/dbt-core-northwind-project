# Copie para .env  ->  cp .env.example .env
# Estes nomes sao os mesmos consumidos por profiles.yml via env_var()

# Conexao usada pelo dbt DENTRO da rede do compose
DB_HOST_PROD=postgres
DB_PORT_PROD=5432
DB_USER_PROD=northwind
DB_PASS_PROD=northwind
DB_NAME_PROD=northwind
DB_SCHEMA_PROD=public
DB_THREADS_PROD=4

# Portas expostas na sua maquina (5432/8080 podem ja estar em uso por outros containers)
POSTGRES_HOST_PORT=5433
PGADMIN_HOST_PORT=8081
DBT_DOCS_HOST_PORT=8082

# Credenciais de login do pgAdmin (o pgAdmin rejeita TLDs invalidos como .local)
PGADMIN_EMAIL=admin@northwind.com
PGADMIN_PASSWORD=admin
